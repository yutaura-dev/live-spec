{
  "name": "@yutaura/live-spec",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "AI が書き、人が見て理解できる「生きた仕様書」を作るツール。素の TypeScript で書いた仕様を実行し、状態遷移図・画面・できる／できない理由・検査結果をまとめた仕様書を生成する",
  "keywords": [
    "specification",
    "living-documentation",
    "state-machine",
    "spec-driven-development",
    "wireframe"
  ],
  "homepage": "https://github.com/yutaura-dev/live-spec#readme",
  "bugs": "https://github.com/yutaura-dev/live-spec/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yutaura-dev/live-spec.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "live-spec": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills/*/SKILL.md",
    ".claude-plugin/plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/rewrite-dts-extensions.mjs dist && node scripts/copy-skills.mjs skills",
    "prepack": "pnpm build",
    "spec": "node src/cli.ts"
  },
  "packageManager": "pnpm@12.23.0",
  "dependencies": {
    "@babel/parser": "8.1.3",
    "effect": "4.1.5",
    "elkjs": "0.12.1"
  },
  "devDependencies": {
    "@babel/types": "8.1.3",
    "@effect/vitest": "4.1.5",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
